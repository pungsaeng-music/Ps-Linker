      const handleExportChatRoom = (roomId) => {
        const room = rooms.find(r => r.id === (roomId || activeRoomId));
        if (!room) return;

        const roomMsgs = allMessages.filter(m => m.roomId === room.id).sort((a, b) => (a.timestamp || 0) - (b.timestamp || 0));
        
        let content = `=========================================\n`;
        content += `풍생 링커 (Poongsaeng Linker) 대화방 내보내기\n`;
        content += `=========================================\n`;
        content += `대화방 제목: ${room.title}\n`;
        content += `카테고리: ${CATEGORIES[room.category]?.name || room.category}\n`;
        content += `개설자: ${room.creator} (${room.creatorEmail})\n`;
        content += `개설일시: ${new Date(room.createdAt || Date.now()).toLocaleString('ko-KR')}\n`;
        content += `내보낸 일시: ${new Date().toLocaleString('ko-KR')}\n`;
        content += `=========================================\n\n`;

        roomMsgs.forEach((m, idx) => {
          const timeStr = new Date(m.timestamp || Date.now()).toLocaleString('ko-KR');
          if (m.isSystem) {
            content += `[SYSTEM] ${m.text} (${timeStr})\n`;
          } else {
            const senderUser = adminUserList.find(u => u.email === m.senderEmail || u.nickname === m.sender);
            const displayName = senderUser ? m.sender : '🚫 삭제된 계정입니다';
            content += `[${idx + 1}] ${displayName} (${timeStr})\n`;
            if (m.text) content += `    ${m.text}\n`;
            if (m.image) content += `    [첨부 이미지 포함됨]\n`;
          }
          content += `\n`;
        });

        const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = `풍생링커_대화록_${room.title.replace(/[^\w\s-]/gi, '_')}.txt`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);

        triggerToast('📥 대화방 내역이 TXT 파일로 다운로드되었습니다!', 'success');
      };

      const handleExportAllData = () => {
        const exportData = {
          exportedAt: new Date().toISOString(),
          rooms: rooms,
